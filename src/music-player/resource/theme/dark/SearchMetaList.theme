SearchMetaList {
  color: #2ca7f8;
  border-radius: 4px;
  background-color: rgba(255, 255, 255, 0.1);
  outline: none;
  border: none;
}

SearchMetaList::item {
  border: none;
  color: #2ca7f8;
  background-color: transparent;
  height: 52px;
}

SearchMetaList::item:selected {
  color: white;
  background-color: rgba(255, 255, 255, 0.15);
}