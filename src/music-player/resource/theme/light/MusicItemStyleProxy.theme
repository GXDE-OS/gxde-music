#MusicItemStyleProxy {
  qproperty-textColor: rgba(0, 0, 0, 50%);
  qproperty-titleColor: rgba(0, 0, 0, 85%);
  qproperty-highlightText: white;
  qproperty-background: #ffffff;
  qproperty-alternateBackground: rgba(0, 0, 0, 5%);
  qproperty-highlightedBackground: #2ca7f8;
  qproperty-playingIcon: ":/common/image/playing_normal.svg";
  qproperty-highlightPlayingIcon: ":/common/image/playing_active.svg";
}
