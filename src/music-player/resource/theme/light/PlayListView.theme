#PlayListView {
  color: #2ca7f8;
  border: 0px solid rgba(44, 167, 248, 0.7);
  background-color: rgba(255, 255, 255, 0.0);
  outline: none;
}

#PlayListView::item {
  color: #2ca7f8;
  height: 56px;
}

#PlayListView::item:selected:!active {
  color: white;
  background-color: qlineargradient(x1: 0 y1: 0, x2: 1 y2: 0, stop: 0 #2ca7f8, stop: 0.015 #2ca7f8, stop: 0.0155 rgba(44, 167, 248, 20%), stop: 1 rgba(44, 167, 248, 20%));
}

#PlayListView::item:selected:active {
  color: white;
  background-color: qlineargradient(x1: 0 y1: 0, x2: 1 y2: 0, stop: 0 #2ca7f8, stop: 0.015 #2ca7f8, stop: 0.0155 rgba(44, 167, 248, 20%), stop: 1 rgba(44, 167, 248, 20%));
}